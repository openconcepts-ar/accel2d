	(gr_text "Avaota-A1 design\nBGA pad: 0.2285\ntrack: 0.076\nclearance: 0.09775\nvia-in-pad: 0.4/0.3\novals: 0.2-0.305 (replacing .25)\nSoldermask: matches BGA pad\n\n"
